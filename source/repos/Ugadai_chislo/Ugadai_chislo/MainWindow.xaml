<Window x:Class="Ugadai_chislo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Угадай число" Height="360" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Введите число от 1 до 100"
                   FontSize="16"
                   Margin="0,0,0,8"/>

        <TextBox x:Name="txtNumber"
                 Grid.Row="1"
                 FontSize="16"
                 Height="30"
                 Margin="0,0,0,10"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="btnCheck"
                    Content="Проверить"
                    Width="120"
                    Height="30"
                    Margin="0,0,8,0"
                    Click="BtnCheck_Click"/>
            <Button Content="Новая игра"
                    Width="120"
                    Height="30"
                    Click="BtnNewGame_Click"/>
        </StackPanel>

        <TextBlock x:Name="txtHint"
                   Grid.Row="3"
                   FontSize="16"
                   TextWrapping="Wrap"
                   MinHeight="48"
                   Margin="0,0,0,12"/>

        <TextBlock x:Name="txtAttempts"
                   Grid.Row="4"
                   Margin="0,0,0,6"
                   Text="Попыток: 0 из 10"/>

        <ProgressBar x:Name="progressAttempts"
                     Grid.Row="5"
                     Height="22"
                     Minimum="0"
                     Maximum="10"
                     Value="0"/>
    </Grid>
</Window>
