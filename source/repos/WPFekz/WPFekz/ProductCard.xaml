<UserControl x:Class="WPFekz.ProductCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPFekz"
             mc:Ignorable="d" 
             d:DesignHeight="240" d:DesignWidth="400">
    <Border x:Name="CardBorder" BorderBrush="#CCC" BorderThickness="1" CornerRadius="4" Padding="8" Background="White">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
            </Grid.ColumnDefinitions>
            <Image x:Name="ImgPhoto" Grid.Column="0" Stretch="Uniform" Margin="0,0,10,0"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TbTitle" FontWeight="Bold" FontSize="14"/>
                <TextBlock x:Name="TbDesc" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                <TextBlock x:Name="TbManufac" Margin="0,2,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <TextBlock Text="Цена: " FontWeight="SemiBold"/>
                    <TextBlock x:Name="TbOldPrice" Foreground="Red" TextDecorations="Strikethrough" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TbPrice" FontWeight="Bold" Foreground="Black"/>
                </StackPanel>

                <TextBlock x:Name="TbCount" Margin="0,2,0,0"/>
            </StackPanel>
            <Border Grid.Column="2" Background="#F0F0F0" CornerRadius="4" Padding="5" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Скидка" FontSize="11" Foreground="#666"/>
                    <TextBlock x:Name="TbDiscount" FontSize="18" FontWeight="Bold" Foreground="#6A5ACD"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
